# Copiar a .env. NO SUBIR .env A GITHUB.
SAMU_DOMAIN=samu.ejemplo.edu.mx
APP_ENV=production
COOKIE_SECURE=1
# Crear cada secreto de forma aleatoria; no usar contraseñas de este archivo.
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_LARGA_UNICA
DATA_ENCRYPTION_KEY=GENERAR_CON_PYTHON_FERNET
OTP_PEPPER=GENERAR_SECRETO_ALEATORIO
# Configurar SMTP real antes de enviar canalizaciones.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google OAuth 2.0 (Exclusivo para el personal de Enfermería)
# Crear credenciales de "Aplicación web" en Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# URIs de redireccionamiento autorizados:
# https://samu.ejemplo.edu.mx/api/auth/google/callback (producción)
# http://127.0.0.1:8000/api/auth/google/callback (desarrollo local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=




